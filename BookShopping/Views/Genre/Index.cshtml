@model BookShopping.Utility.PagedResult<BookShopping.Models.Genre>
@{
    Layout = "_AdminLayout";
}

<h2>Genres</h2>

<a asp-action="AddGenre" asp-controller="Genre" class="btn btn-primary mb-2">Add More</a>

@if (Model?.Data.Count > 0)
{
    <table class="table table-striped my-2">
        <tr>
            <th>Genre</th>
            <th>Action</th>
        </tr>
        @foreach (var genre in Model.Data)
        {
            <tr>
                <td>@genre.GenreName</td>
                <td>
                    <a asp-action="UpdateGenre" asp-route-id="@genre.Id" class="btn btn-success">Edit</a>
                    <a asp-action="DeleteGenre" asp-route-id="@genre.Id" class="btn btn-danger"
                       onclick="return confirm('Are you sure you want to delete this genre?')">Delete</a>
                </td>
            </tr>
        }
    </table>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination flex-wrap gap-1">

            <!-- Previous Button -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link rounded-pill" href="?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize" aria-label="Previous">
                    <span aria-hidden="true">&laquo; Prev</span>
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link rounded-circle" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded-pill" href="?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize" aria-label="Next">
                    <span aria-hidden="true">Next &raquo;</span>
                </a>
            </li>

        </ul>
    </nav>
}
else
{
    <p>No genres available.</p>
}
