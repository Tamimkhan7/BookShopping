@model BookShoppingCartMvcUI.Models.DTOs.TopNSoldBooksVm

<h2 class="text-center">Top 5 Selling Books</h2>
@* <hr class="border border-dark border-2 opacity-100" /> *@


<hr class="border border-dark border-2 opacity-100 mb-4" />

<form method="get" asp-action="Top5Sellers" class="mt-6 p-4">
    <label>Start Date:</label>
    <input type="date" name="startDate" value="@Model?.StartDate.ToString("yyyy-MM-dd")" />

    <label class="ml-3">End Date : </label>
    <input type="date" name="endDate" value="@Model?.EndDate.ToString("yyyy-MM-dd")" />

    <button type="submit" class="btn btn-primary">Search</button>
</form>

@* <p>From @Model.StartDate.ToShortDateString() to @Model.EndDate.ToShortDateString()</p> *@

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Rank</th>
            <th>Book Name</th>
            <th>Author</th>
            <th>Total Sold</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var (book, index) in Model.TopNSoldBooks.Select((b, i) => (b, i + 1)))
        {
            <tr>
                <td>@index</td>
                <td>@book.BookName</td>
                <td>@book.AuthorName</td>
                <td>@book.TotalUnitSold</td>
            </tr>
        }
    </tbody>
</table>
