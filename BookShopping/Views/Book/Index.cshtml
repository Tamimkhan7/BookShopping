@model BookShopping.Utility.PagedResult<Book>
@{
    Layout = "_AdminLayout";
}

<h1>Books</h1>

<a asp-action="AddBook" asp-controller="Book" class="btn btn-primary mb-2">Add More</a>

@if (Model?.Data.Count > 0)
{
    <table class="table table-striped my-2">
        <tr>
            <th>Image</th>
            <th>Book</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Discount (%)</th>
            <th>Final Price</th>
            <th>Action</th>
        </tr>
        @foreach (var book in Model.Data)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrWhiteSpace(book.Image))
                    {
                        <img src="/Image/@book.Image" style="width:80px; height:100px" alt="book image" />
                    }
                    else
                    {
                        <img src="/Image/Image.jpg" style="width:80px; height:100px" alt="default image" />
                    }
                </td>
                <td>@book.BookName</td>
                <td>@book.AuthorName</td>
                <td>@book.Genre?.GenreName</td>
                <td>@book.Price</td>
                <td>@book.DiscountPercentage %</td>
                <td>@book.DiscountedPrice</td>
                <td>
                    <a asp-action="UpdateBook" asp-route-id="@book.Id" class="btn btn-success">Edit</a>
                    <a asp-action="DeleteBook" asp-route-id="@book.Id" class="btn btn-danger"
                       onclick="return confirm('Are you sure you want to remove it')">Delete</a>
                </td>
            </tr>
        }
    </table>

    <!-- Pagination -->
    <nav>
        <ul class="pagination">

            <!-- Previous Button -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize" aria-label="Previous">
                    <span aria-hidden="true">&laquo; Prev</span>
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize" aria-label="Next">
                    <span aria-hidden="true">Next &raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}
else
{
    <p>No books available.</p>
}
