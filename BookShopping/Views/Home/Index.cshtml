@using BookShopping.Models.DTOs
@model BookDisplayModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="row g-4">
    <!-- Sidebar Filter -->
    <div class="col-lg-3">
        <div class="card p-3 shadow-sm">
            <h5 class="mb-3 text-primary"> Search</h5>
            <form asp-action="Index" method="get">
                <div class="mb-3">
                    <input type="text" class="form-control" name="strem" value="@Model.STerm" placeholder="Search by title" />
                </div>

                <h5 class="mb-2 text-primary"> Genre</h5>
                <div class="mb-3">
                    <select name="genreId" class="form-select">
                        <option value="0">All</option>
                        @foreach (var g in Model.Genres)
                        {
                            <option value="@g.Id" selected="@(g.Id == Model.GenreId ? "selected" : null)">@g.GenreName</option>
                        }
                    </select>
                </div>

                <h5 class="mb-2 text-primary"> Author</h5>
                <div class="mb-3">
                    <select name="author" class="form-select">
                        <option value="">All</option>
                        @foreach (var a in Model.Authors)
                        {
                            <option value="@a" selected="@(a == Model.SelectedAuthor ? "selected" : null)">@a</option>
                        }
                    </select>
                </div>

                <h5 class="mb-2 text-primary"> Sort By</h5>
                <div class="mb-3">
                    <select name="sortBy" class="form-select">
                        <option value="">Title (A-Z)</option>
                        <option value="bestseller" selected="@(Model.SortBy == "bestseller" ? "selected" : null)">Best Seller</option>
                        <option value="rating" selected="@(Model.SortBy == "rating" ? "selected" : null)">Top Rating</option>
                        <option value="new" selected="@(Model.SortBy == "new" ? "selected" : null)">New Arrival</option>
                        <option value="pricelow" selected="@(Model.SortBy == "pricelow" ? "selected" : null)">Price: Low → High</option>
                        <option value="pricehigh" selected="@(Model.SortBy == "pricehigh" ? "selected" : null)">Price: High → Low</option>
                        @* <option value="year" selected="@(Model.SortBy == "year" ? "selected" : null)">Published Year</option> *@
                    </select>
                </div>

                <h5 class="mb-2 text-primary">Price Range</h5>
                <div class="d-flex mb-3 gap-2">
                    <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control" placeholder="Min" />
                    <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control" placeholder="Max" />
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-2">Apply Filters</button>
                <a href="/Home/Index" class="btn btn-outline-secondary w-100">Reset</a>
            </form>
        </div>
    </div>

    <!-- Book List -->
    <div class="col-lg-9">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var book in Model.PagedBooks.Data)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrEmpty(book.Image) ? "/Image/Image.jpg" : "/Image/Image.jpg")"
                             class="card-img-top" style="height:150px; width: 150px; object-fit:cover;" alt="@book.BookName" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@book.BookName</h5>
                            <p class="card-text mb-1">
                                <span class="badge bg-info text-white">
                                    <strong class="fs-6">Genre: </strong>
                                    <span class="fs-6 fw-bold">@book.GenreName</span>
                                </span>
                                <br />
                                <span class="badge bg-secondary mt-2">
                                    <strong class="fs-7">Author: </strong>
                                    <span class="fs-7 fw-bold">@book.AuthorName</span>
                                </span>

                            </p>
                           <p class="card-text fw-bold mb-2"><strong>Price: </strong>$@book.Price</p>

                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(book.AverageRating))
                                    {
                                        <span class="text-warning">&#9733;</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">&#9733;</span>
                                    }
                                }
                            </div>

                            <div class="mt-auto d-flex flex-column gap-2">
                                @if (book.Quantity > 0)
                                {
                                    <button type="button" onclick="addToCart(@book.Id)" class="btn btn-success w-100">Add to Cart</button>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold text-center">Out of Stock</span>
                                }

                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary w-100">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PagedBooks.PageNumber == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="?page=@(Model.PagedBooks.PageNumber - 1)&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId&author=@Model.SelectedAuthor&sortBy=@Model.SortBy&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice">Prev</a>
                </li>

                @for (int i = 1; i <= Model.PagedBooks.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PagedBooks.PageNumber ? "active" : "")">
                        <a class="page-link"
                           href="?page=@i&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId&author=@Model.SelectedAuthor&sortBy=@Model.SortBy&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PagedBooks.PageNumber == Model.PagedBooks.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="?page=@(Model.PagedBooks.PageNumber + 1)&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId&author=@Model.SelectedAuthor&sortBy=@Model.SortBy&minPrice=@Model.MinPrice&maxPrice=@Model.MaxPrice">Next</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        async function addToCart(bookId) {
            var usernameEl = document.getElementById("username");
            if (!usernameEl) window.location.href = "/Identity/Account/Login";

            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status === 200) {
                    var result = await response.json();
                    document.getElementById("cartCount").innerHTML = result;
                    window.location.href = "#cartCount";
                }
            } catch (err) {
                console.log(err);
            }
        }
    </script>
}
