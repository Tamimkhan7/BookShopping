@using BookShopping.Models.DTOs
@model BookDisplayModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="my-2">
    <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
        <div class="col-12">
            <label class="visually-hidden" for="genreId">Genres</label>
            <select class="form-select" id="genreId" name="genreId">
                <option value="">Genre</option>
                @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                }
            </select>
        </div>

        <div class="col-12">
            <label class="visually-hidden" for="strem">Search by title</label>
            <div class="input-group">
                <input type="text" class="form-control" id="strem" value="@Model.STerm" name="strem" placeholder="Search by title">
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Search</button>
            <a href="/Home/Index" class="btn btn-dark">Reset</a>
        </div>
    </form>
</div>

<div class="w-100 d-flex flex-wrap mt-4">
    @foreach (var book in Model.PagedBooks.Data)
    {
        <div class="card mx-3 mb-4" style="width: 17rem;">
            <img style="width:100%; height:180px" src="@(string.IsNullOrEmpty(book.Image) ? "/Image/Image.jpg" : book.Image)" class="card-img-top" alt="@book.BookName">

            <div class="card-body">
                <h5 class="card-title"><b>@book.BookName</b></h5>
                <p class="card-text">
                    <b>Genre</b> : @book.GenreName<br />
                    <b>Author</b>: @book.AuthorName<br />
                    <b>Price</b> : $@book.Price
                </p>

                <h6>
                    Rating:
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(book.AverageRating))
                        {
                            <span style="color: gold;">&#9733;</span>
                        }
                        else
                        {
                            <span style="color: lightgray;">&#9733;</span>
                        }
                    }
                </h6>

                @if (book.Quantity > 0)
                {
                    <button type="button" onclick="addToCart(@book.Id)" class="btn btn-primary mt-2">Add to cart</button>
                }
                else
                {
                    <span class="border border-danger rounded px-2 py-1 text-danger d-inline-block mt-2">Out of Stock</span>
                }

                <a asp-action="Details" asp-route-id="@book.Id"
                   class="btn btn-secondary @(book.Quantity > 0 ? "mt-2" : "")">
                    View Details
                </a>
            </div>
        </div>
    }
</div>

<!-- Pagination -->
<nav >
    <ul class="pagination">
        <li class="page-item @(Model.PagedBooks.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PagedBooks.PageNumber - 1)&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId">Prev</a>
        </li>

        @for (int i = 1; i <= Model.PagedBooks.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PagedBooks.PageNumber ? "active" : "")">
                <a class="page-link" href="?page=@i&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId">@i</a>
            </li>
        }

        <li class="page-item @(Model.PagedBooks.PageNumber == Model.PagedBooks.TotalPages ? "disabled" : "")">
            <a class="page-link" href="?page=@(Model.PagedBooks.PageNumber + 1)&pageSize=@Model.PagedBooks.PageSize&strem=@Model.STerm&genreId=@Model.GenreId">Next</a>
        </li>
    </ul>
</nav>



@section Scripts {
    <script>
        async function addToCart(bookId) {
            var usernameEl = document.getElementById("username");
            if (!usernameEl) window.location.href = "/Identity/Account/Login";

            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status === 200) {
                    var result = await response.json();
                    document.getElementById("cartCount").innerHTML = result;
                    window.location.href = "#cartCount";
                }
            } catch (err) {
                console.log(err);
            }
        }
    </script>
}

