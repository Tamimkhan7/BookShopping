@model BookShopping.Utility.PagedResult<BookShopping.Models.DTOs.StockDisplayModel>
@{
    Layout = "_AdminLayout";
    var sTerm = ViewData["SearchTerm"] as string ?? "";
}

<h2>Stocks</h2>

<form asp-action="Index" method="get" class="my-2 d-flex gap-2">
    <input type="text" name="sTerm" value="@sTerm" class="form-control w-25" placeholder="Search by book" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-action="Index" asp-controller="Stock" class="btn btn-secondary">Clear</a>
</form>

@if (Model?.Data.Count > 0)
{
    <table class="table table-bordered">
        <tr>
            <th>Book</th>
            <th>Stock</th>
            <th>Action</th>
        </tr>
        @foreach (var item in Model.Data)
        {
            <tr>
                <td>@item.BookName</td>
                <td>@item.Quantity</td>
                <td>
                    <a asp-action="ManageStock" asp-route-bookId="@item.BookId" class="btn btn-info">Update Stock</a>
                </td>
            </tr>
        }
    </table>

    <!-- Pagination -->
    <nav aria-label="Page navigation">
        <ul class="pagination flex-wrap gap-1">

            <!-- Previous Button -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link rounded-pill" href="?page=@(Model.PageNumber - 1)&pageSize=@Model.PageSize&sTerm=@sTerm" aria-label="Previous">
                    <span aria-hidden="true">&laquo; Prev</span>
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link rounded-circle" href="?page=@i&pageSize=@Model.PageSize&sTerm=@sTerm">@i</a>
                </li>
            }

            <!-- Next Button -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded-pill" href="?page=@(Model.PageNumber + 1)&pageSize=@Model.PageSize&sTerm=@sTerm" aria-label="Next">
                    <span aria-hidden="true">Next &raquo;</span>
                </a>
            </li>

        </ul>
    </nav>
}
else
{
    <p>No stocks available.</p>
}
